{% extends 'administration/administration_base.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'administration.cleanupStatistic.title'|trans }} - {{ parent() }}{% endblock %}
{% block pageTitle %}{{ 'administration.cleanupStatistic.title'|trans }}{% endblock %}

{% block pageTitleColumn %}
    {{ parent() }}

    <div class="col-auto ms-auto">
        <div class="btn-list">
            <a href="https://documentation.mosparo.io/docs/administration/cleanup_statistic" class="btn btn-info" target="_blank">
                <i class="ti ti-question-mark"></i>
                {{ 'action.help'|trans }}
            </a>
        </div>
    </div>
{% endblock %}

{% block administrationPageBody %}
    <div class="row">
        <div class="col">
            {% include 'ui/grid_table/table.html.twig' with {'table': table, 'identifier': 'cleanupStatistics'} %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% cspscript %}
        <script>
            $(function () {
                new GridTable(
                    $('#cleanupStatistics'),
                    [
                        ['(width >= 1150px)', '1fr min-content 1fr 1fr min-content min-content'],
                        ['(width >= 1050px) and (width < 1150px)', '1fr min-content 1fr 1fr min-content'],
                        ['(width >= 660px) and (width < 1050px)', '1fr min-content 1fr 1fr'],
                        ['(width >= 530px) and (width < 660px)', '1fr min-content 1fr'],
                        ['(width >= 450px) and (width < 530px)', '1fr min-content'],
                        ['(width < 450px)', '1fr'],
                    ]
                );
            });
        </script>
    {% endcspscript %}
{% endblock %}
