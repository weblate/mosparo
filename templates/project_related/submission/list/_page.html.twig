{% trans_default_domain 'mosparo' %}

<div class="origin-page">
    {% if item.submitToken %}
        <div class="page-name">
            {{ item.submitToken.pageTitle }}
        </div>
        <div class="origin-page-url-container">
            <a href="{{ item.submitToken.pageUrl }}" target="_blank" class="origin-page-url">{{ item.submitToken.pageUrl|replace({'https://': ''}) }}</a>
            <i class="ti ti-external-link"></i>
        </div>
    {% else %}
        <span class="status status-warning">
            {{ 'submission.submitTokenMissing'|trans }}
        </span>
    {% endif %}
</div>
