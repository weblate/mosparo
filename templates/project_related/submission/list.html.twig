{% extends 'project_related/project_related_base.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'submission.title'|trans }} - {{ parent() }}{% endblock %}
{% block pageTitle %}{{ 'submission.title'|trans }}{% endblock %}

{% block pageTitleColumn %}
    {{ parent() }}

    <div class="col-auto ms-auto">
        <div class="btn-list">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" title="{{ 'submission.filter.dropdown'|trans }}">
                    <i class="ti ti-filter"></i>
                </button>
                <div class="dropdown-menu">
                    <a href="{{ path('submission_list', { '_projectId': activeProject.id }) }}" class="dropdown-item {% if filter != 'spam' and filter != 'valid' %}active{% endif %}">
                        <i class="ti ti-check {% if filter == 'spam' or filter == 'valid' %}invisible{% endif %}"></i>
                        {{ 'submission.filter.options.all'|trans }}
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="{{ path('submission_list_filtered', { '_projectId': activeProject.id, 'filter': 'spam' }) }}" class="dropdown-item {% if filter == 'spam' %}active{% endif %}">
                        <i class="ti ti-check {% if filter != 'spam' %}invisible{% endif %}"></i>
                        {{ 'submission.filter.options.spam'|trans }}
                    </a>
                    <a href="{{ path('submission_list_filtered', { '_projectId': activeProject.id, 'filter': 'valid' }) }}" class="dropdown-item {% if filter == 'valid' %}active{% endif %}">
                        <i class="ti ti-check {% if filter != 'valid' %}invisible{% endif %}"></i>
                        {{ 'submission.filter.options.valid'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block pageBody %}
    <div class="container-xl">
        <div class="row">
            <div class="col">
                {% include 'ui/grid_table/table.html.twig' with {'table': table, 'identifier': 'submissions'} %}

                <div class="card mt-3">
                    {% if lastDatabaseCleanup %}
                        <div class="card-body text-muted"><strong>{{ 'cleanup.lastDatabaseCleanup'|trans }}</strong> {{ lastDatabaseCleanup|date }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% cspscript %}
        <script>
            $(function () {
                new GridTable(
                    $('#submissions'),
                    [
                        ['(width >= 1200px)', 'min-content 3fr 2fr min-content min-content min-content min-content min-content min-content'],
                        ['(width >= 1100px) and (width < 1200px)', 'min-content 3fr 2fr min-content min-content min-content min-content min-content'],
                        ['(width >= 1000px) and (width < 1100px)', 'min-content 3fr 2fr min-content min-content min-content min-content'],
                        ['(width >= 900px) and (width < 1000px)', 'min-content 3fr 2fr min-content min-content min-content'],
                        ['(width >= 840px) and (width < 900px)', 'min-content 3fr 2fr min-content min-content min-content'],
                        ['(width >= 768px) and (width < 840px)', 'min-content 3fr 2fr min-content min-content'],
                        ['(width >= 600px) and (width < 768px)', 'min-content 3fr 2fr min-content'],
                        ['(width >= 520px) and (width < 600px)', 'min-content 3fr 2fr'],
                        ['(width >= 450px) and (width < 520px)', 'min-content 1fr'],
                        ['(width < 450px)', '1fr'],
                    ],
                    {
                        additionalClassesBreakpoints: [
                            ['(width >= 600px) and (width < 1200px)', 'header-row-right-corner']
                        ],
                        headerGroupBreakpoints: [
                            ['(width >= 600px)', '4/7'],
                            ['(width >= 1000px)', '7/9'],
                        ],
                    }
                );
            });
        </script>
    {% endcspscript %}
{% endblock %}
