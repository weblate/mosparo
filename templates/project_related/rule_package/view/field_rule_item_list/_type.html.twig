{% trans_default_domain 'mosparo' %}

{% set ruleType = rule_type(item.rulePackageRuleCache.type) %}
<span class="text-nowrap">
    {% if ruleType %}
        {% set ruleSubtype = rule_subtype(ruleType, item.type) %}
        {% if ruleSubtype %}
            {{ ruleSubtype|trans }}
        {% else %}
            <code>{{ item.type }}</code>
        {% endif %}
    {% else %}
        <code>{{ item.type }}</code>
    {% endif %}
</span>
