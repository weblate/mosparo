{% extends 'project_related/project_related_base.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'rulePackage.title'|trans }} - {{ parent() }}{% endblock %}
{% block pageTitle %}{{ 'rulePackage.title'|trans }}{% endblock %}

{% block pageTitleColumn %}
    {{ parent() }}

    <div class="col-auto ms-auto">
        <div class="btn-list">
            <a href="https://documentation.mosparo.io/docs/usage/rule_packages" class="btn btn-info hide-text" target="_blank">
                <i class="ti ti-question-mark"></i>
                <span>{{ 'action.help'|trans }}</span>
            </a>
            {% if canManage %}
                {% if hasRulePackages %}
                    <a href="{{ path('rule_package_update_cache_all', {'_projectId': activeProject.id}) }}" class="btn btn-teal hide-text">
                        <i class="ti ti-refresh"></i>
                        <span>{{ 'action.updateCache'|trans }}</span>
                    </a>
                {% endif %}
                <a href="{{ path('rule_package_add_choose_type', { '_projectId': activeProject.id }) }}" class="btn btn-success add-button">
                    <i class="ti ti-plus"></i>
                    <span>{{ 'rulePackage.add.title'|trans }}</span>
                </a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block pageBody %}
    <div class="container-xl">
        <div class="row">
            <div class="col">
                {% include 'ui/grid_table/table.html.twig' with {'table': table, 'identifier': 'rulePackages'} %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% cspscript %}
        <script>
            $(function () {
                new GridTable(
                    $('#rulePackages'),
                    [
                        ['(width >= 1400px)', '1fr  min-content min-content min-content min-content min-content'],
                        ['(width >= 992px) and (width < 1400px)', '1fr min-content min-content min-content min-content'],
                        ['(width >= 768px) and (width < 992px)', '1fr min-content min-content min-content'],
                        ['(width >= 570px) and (width < 768px)', '1fr min-content min-content'],
                        ['(width >= 450px) and (width < 570px)', '1fr min-content'],
                        ['(width < 450px)', '1fr'],
                    ]
                );
            });
        </script>
    {% endcspscript %}
{% endblock %}
