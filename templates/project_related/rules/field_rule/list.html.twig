{% extends 'project_related/rules/rules_base.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'rules.fieldRule.title'|trans }} - {{ parent() }}{% endblock %}
{% block pageTitle %}{{ 'rules.fieldRule.title'|trans }}{% endblock %}

{% block pageTitleColumn %}
    {{ parent() }}

    <div class="col-auto ms-auto">
        <div class="btn-list">
            <a href="https://documentation.mosparo.io/docs/usage/rules" class="btn btn-info" target="_blank">
                <i class="ti ti-question-mark"></i>
                {{ 'action.help'|trans }}
            </a>

            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" title="{{ 'rules.fieldRule.filter.dropdown'|trans }}">
                    <i class="ti ti-filter"></i>
                </button>
                <div class="dropdown-menu">
                    <a href="{{ path('rules_field_rule_list', { '_projectId': activeProject.id }) }}" class="dropdown-item {% if filter == '' %}active{% endif %}">
                        <i class="ti ti-check {% if filter != '' %}invisible{% endif %}"></i>
                        {{ 'rules.fieldRule.filter.options.all'|trans }}
                    </a>
                    <div class="dropdown-divider"></div>
                    {% for ruleType in ruleTypes %}
                        <a href="{{ path('rules_field_rule_list_filtered', { '_projectId': activeProject.id, 'filter': ruleType.key }) }}" class="dropdown-item {% if filter == ruleType.key %}active{% endif %} {% if not numberOfRulesByType[ruleType.key] is defined %}disabled{% endif %}">
                            <i class="ti {% if filter == ruleType.key %}ti-check{% else %}{{ ruleType.icon }}{% endif %}"></i>
                            {{ ruleType.name|trans }}

                            {% if numberOfRulesByType[ruleType.key] is defined %}
                                <span class="badge bg-primary ms-2">{{ numberOfRulesByType[ruleType.key] }}</span>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {% if canManage %}
                <a href="{{ path('rules_field_rule_create_choose_type', { '_projectId': activeProject.id }) }}" class="btn btn-success add-button">
                    <i class="ti ti-plus"></i>
                    <span>{{ 'rules.fieldRule.create.title'|trans }}</span>
                </a>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block rulesPageBody %}
    {% set emptyMessage %}
        <div class="text-center">
            <p>{{ 'rules.fieldRule.list.empty'|trans }}</p>

            {% if canManage %}
                <a href="{{ path('rules_field_rule_create_choose_type', { '_projectId': activeProject.id }) }}" class="btn btn-success add-button">
                    <i class="ti ti-plus"></i>
                    <span>{{ 'rules.fieldRule.create.title'|trans }}</span>
                </a>
            {% endif %}
        </div>
    {% endset %}

    <div class="row">
        <div class="col">
            {% include 'ui/grid_table/table.html.twig' with {'table': table, 'identifier': 'rules', 'emptyMessage': emptyMessage, 'emptyMessageRaw': true} %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% cspscript %}
        <script>
            $(function () {
                new GridTable(
                    $('#rules'),
                    [
                        ['(width >= 768px)', '1fr 20% 20% min-content'],
                        ['(width >= 500px) and (width < 768px)', '1fr min-content min-content'],
                        ['(width >= 450px) and (width < 500px)', '1fr min-content'],
                        ['(width < 450px)', '1fr'],
                    ]
                );
            });
        </script>
    {% endcspscript %}
{% endblock %}
