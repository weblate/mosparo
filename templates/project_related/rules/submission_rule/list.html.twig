{% extends 'project_related/rules/rules_base.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'rules.submissionRule.title'|trans }} - {{ parent() }}{% endblock %}
{% block pageTitle %}{{ 'rules.submissionRule.title'|trans }}{% endblock %}

{% block pageTitleColumn %}
    {{ parent() }}

    <div class="col-auto ms-auto">
        <div class="btn-list">
            <a href="https://documentation.mosparo.io/docs/usage/rules" class="btn btn-info" target="_blank">
                <i class="ti ti-question-mark"></i>
                {{ 'action.help'|trans }}
            </a>
        </div>
    </div>
{% endblock %}

{% block rulesPageBody %}
    <div class="row">
        <div class="col">
            {% include 'ui/grid_table/table.html.twig' with {'table': table, 'identifier': 'submissionRules'} %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% cspscript %}
        <script>
            $(function () {
                new GridTable(
                    $('#submissionRules'),
                    [
                        ['(width >= 768px)', '1fr 15% min-content'],
                        ['(width >= 500px) and (width < 768px)', '1fr min-content min-content'],
                        ['(width >= 450px) and (width < 500px)', '1fr min-content'],
                        ['(width < 450px)', '1fr'],
                    ]
                );
            });
        </script>
    {% endcspscript %}
{% endblock %}
