{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-simplexml": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "composer/package-versions-deprecated": "1.11.99.1",
        "danielsreichenbach/geoip2-update": "^2.5",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6",
        "endroid/qr-code": "^6.0",
        "geoip2/geoip2": "^3.3",
        "gracious/doctrine-encryption-bundle": "^5.0",
        "mlocati/ip-lib": "^1.22",
        "mosparo/php-api-client": "^2.0",
        "mosparo/specifications": "^7.0",
        "nelmio/security-bundle": "^3.0",
        "opis/json-schema": "^2.6",
        "paragonie/sodium_compat": "^2.5",
        "phpdocumentor/reflection-docblock": "^6.0",
        "predis/predis": "^3.5",
        "rkr/wildcards": "1.*",
        "scheb/2fa-backup-code": "^7.14",
        "scheb/2fa-bundle": "^7.14",
        "scheb/2fa-google-authenticator": "^7.14",
        "symfony-bundles/json-request-bundle": "^4.2",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^3.8",
        "symfony/polyfill-uuid": "^1.26",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "^7.4",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "7.4.*",
        "symfonycasts/reset-password-bundle": "^1.25",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.24",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.25",
        "zepi/unicode": "^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/debug-bundle": "^7.4",
        "symfony/maker-bundle": "^1.67",
        "symfony/panther": "^2.4",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^7.4",
        "symfony/var-dumper": "^7.4",
        "symfony/web-profiler-bundle": "^7.4"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "Mosparo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mosparo\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "suggest": {
        "ext-sodium": "*",
        "ext-zend-opcache": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
